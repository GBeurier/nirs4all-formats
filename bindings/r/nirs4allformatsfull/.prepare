#!/bin/sh
# R-universe pre-build hook.
#
# R-universe's build backend (r-universe-org/build-source) clones the WHOLE
# monorepo and runs this script from the package directory BEFORE `R CMD build`,
# while the full tree — including the top-level `crates/` core at ../../../crates
# — is still on disk. That is the only window in which the out-of-tree
# nirs4all-formats{,-core} crates are reachable, so we vendor them here (exactly
# the step the CRAN CI runs).
#
# `N4FMT_R_VENDOR=1 ./configure` copies the core crates into src/rust/vendored/,
# emits a self-contained src/rust/Cargo.toml, and `cargo vendor`s every
# crates.io transitive dep into src/rust/vendor/ with a source-replacement
# .cargo/config.toml. `R CMD build` then bundles src/rust/vendored/ +
# src/rust/vendor/ into the source tarball, so every later step (the tarball's
# own configure on install) builds a self-contained, OFFLINE staticlib with no
# external crates/ and no network. See docs/dev/release_process.md.
set -e
N4FMT_R_VENDOR=1 ./configure
