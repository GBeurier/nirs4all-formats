#!/bin/sh
# Generate a SELF-CONTAINED src/rust/ tree for the nirs4allformats R package
# (the DEFAULT / COMPLETE reader build — every reader incl. HDF5/netCDF,
# Parquet/Arrow and MATLAB). The smaller sibling nirs4allformats.lite
# (bindings/r/nirs4allformatslite) drops only the Parquet/Arrow reader.
#
# The package is an extendr (Rust) binding. Its src/rust/Cargo.toml reaches the
# workspace core crates via RELATIVE paths `../../../../../crates/...`, which
# only resolve INSIDE the monorepo. CRAN unpacks the source tarball with no
# `crates/`, and R-universe builds from the package subdir — so the off-tree
# build would be FATAL without vendoring. This is the Rust analog of
# nirs4all-methods' `N4M_R_VENDOR=1 ./configure` C++ vendoring.
#
# Two modes:
#
#   N4FMT_R_VENDOR=1  -> in-repo vendoring (forced). Copy the workspace core
#                        crates (nirs4all-formats-core, nirs4all-formats) from
#                        the checkout into src/rust/vendored/, emit a
#                        src/rust/Cargo.toml that points at those copies (paths
#                        INSIDE the tarball), `cargo vendor` every crates.io
#                        transitive dependency, compress it to
#                        src/rust/vendor.tar.xz, and write
#                        src/rust/.cargo/config.toml so the R install builds
#                        OFFLINE (CRAN / R-universe installs never hit the
#                        network). The source tarball ships src/rust/vendored/,
#                        src/rust/vendor.tar.xz, the workspace Cargo.toml +
#                        Cargo.lock, and .cargo/config.toml.
#
#                        The crates.io deps are shipped COMPRESSED (vendor.tar.xz,
#                        extracted by src/Makevars at build time) rather than as a
#                        raw directory because `R CMD build`'s tarball step strips
#                        VCS dotfiles (.gitmodules, ...) and a few bundled-C
#                        artifacts from inside the vendored crates, which would
#                        break cargo's offline checksum verification. Shipping the
#                        archive byte-for-byte avoids that (this is the same
#                        pattern the arrow / gifski / polars CRAN packages use for
#                        their Rust vendor trees).
#
#   (default)         -> already-vendored build. When src/rust/vendor.tar.xz and
#                        src/rust/vendored/ are already present (the installing
#                        user unpacked the CRAN source tarball and has no repo),
#                        DO NOT re-vendor: the bundled tree is used as-is.
#                        src/Makevars extracts vendor.tar.xz and `cargo build
#                        --offline` compiles it.
#
# This script writes NO Makevars (src/Makevars / src/Makevars.win are committed,
# layout-stable, and extract vendor.tar.xz then `cargo build` against src/rust/).
set -e

PKG_ROOT=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$PKG_ROOT/../../.." && pwd)   # bindings/r/nirs4allformats -> repo root
RUST="$PKG_ROOT/src/rust"
VENDORED="$RUST/vendored"          # copied workspace core crates (plain dirs)
VENDOR_ARCHIVE="$RUST/vendor.tar.xz"  # compressed cargo-vendored crates.io deps

# The two workspace crates the extendr bridge depends on. Inspecting their
# Cargo.toml [dependencies] for `path =`: nirs4all-formats -> nirs4all-formats-core
# is the only intra-workspace path dep; both are copied below.
CORE_CRATES="nirs4all-formats-core nirs4all-formats"

VENDORED_PRESENT=0
[ -f "$VENDORED/nirs4all-formats-core/Cargo.toml" ] && [ -f "$VENDOR_ARCHIVE" ] && VENDORED_PRESENT=1

if [ "${N4FMT_R_VENDOR:-0}" != "1" ] && [ "$VENDORED_PRESENT" = "1" ]; then
    echo "nirs4allformats configure: using bundled vendored Rust tree (offline build)"
    echo "  vendored crates : $VENDORED"
    echo "  cargo vendor    : $VENDOR_ARCHIVE (extracted by src/Makevars)"
    exit 0
fi

if [ "${N4FMT_R_VENDOR:-0}" != "1" ] && [ "$VENDORED_PRESENT" = "0" ]; then
    # Neither forced-vendor nor a pre-vendored tarball: a raw checkout where the
    # committed src/rust/Cargo.toml (relative paths) and an online `cargo build`
    # are expected (dev inner loop). Leave the tree as-is.
    echo "nirs4allformats configure: no vendored tree and N4FMT_R_VENDOR!=1 — using in-repo src/rust/Cargo.toml (dev mode, needs the monorepo + network)"
    exit 0
fi

# ---------------------------------------------------------------------------
# N4FMT_R_VENDOR=1: in-repo vendoring.
# ---------------------------------------------------------------------------
command -v cargo >/dev/null 2>&1 || {
    echo "nirs4allformats configure(vendor): ERROR — cargo not found; install Rust from https://rustup.rs" >&2
    exit 1
}

echo "nirs4allformats configure: CRAN/R-universe self-contained build — vendoring the Rust core from the checkout"

# 1. Copy the workspace core crates into src/rust/vendored/ (always fresh).
#    Copy sources only (Cargo.toml + src/). tests/ and any local target/ are
#    excluded so the vendored crate carries no [dev-dependencies] surface and no
#    build artefacts. These plain dirs ship in the tarball as-is (no dotfiles).
rm -rf "$VENDORED" "$VENDOR_ARCHIVE" "$RUST/vendor-config.toml" "$RUST/vendor" "$RUST/.cargo" "$RUST/Cargo.lock"
mkdir -p "$VENDORED"
for c in $CORE_CRATES; do
    [ -d "$REPO/crates/$c" ] || {
        echo "nirs4allformats configure(vendor): ERROR — $REPO/crates/$c not found" >&2
        exit 1
    }
    mkdir -p "$VENDORED/$c"
    cp "$REPO/crates/$c/Cargo.toml" "$VENDORED/$c/Cargo.toml"
    cp -R "$REPO/crates/$c/src"     "$VENDORED/$c/src"
done

# 1a. FULL build (complete reader set). The vendored facade manifest keeps its
#     default features (`formats-all` -> every reader: HDF5/netCDF, Parquet/Arrow,
#     MATLAB), so the optional readers and the `[features]` table are LEFT INTACT
#     (the staticlib's [dependencies] below uses default features). We only strip
#     the test-only [dev-dependencies] tables from the vendored crate manifests:
#     `cargo vendor` (step 3) collects the UNION of every reachable dependency,
#     dev ones included, and the facade's `tempfile` dev-dep pulls a multi-MB WASI
#     closure (`getrandom 0.4` -> `wit-bindgen`/`wasmparser`/`wasip2/3`/`r-efi` +
#     `rustix`/`linux-raw-sys`/`windows-sys`) that the R package never compiles
#     (R never runs the crate's `cargo test`). Removing it is a harmless ~4 MB
#     saving with no effect on the build. This mirrors the dev-dep strip the lite
#     sibling (nirs4allformats.lite) also applies; the lite additionally drops the
#     Parquet optional readers.
if command -v python3 >/dev/null 2>&1; then
    echo "nirs4allformats configure: FULL — stripping test-only dev-dependencies from the vendored facade manifest (keeping every reader)"
    for m in "$VENDORED"/*/Cargo.toml; do
        python3 - "$m" <<'PY'
import re, sys

p = sys.argv[1]
lines = open(p, encoding="utf-8").read().splitlines()

# Delete every [dev-dependencies] table (incl. target-scoped variants like
# `[target.'cfg(...)'.dev-dependencies]`) in full — they are test-only and pull a
# multi-MB WASI/getrandom closure into the vendor tree for no build benefit. The
# [features] table and every optional dependency are LEFT untouched: this is the
# complete build, so all readers stay.
out, section, dev_dropped = [], None, 0


def is_dev_deps(name):
    # Matches `dev-dependencies` and `target.<cfg>.dev-dependencies`.
    return name == "dev-dependencies" or name.endswith(".dev-dependencies")


for ln in lines:
    header = re.match(r"\s*\[([^\]]+)\]\s*$", ln)
    if header:
        section = header.group(1)
        if is_dev_deps(section):
            # Drop the whole [dev-dependencies] table header; its body lines are
            # skipped below until the next `[` header re-assigns `section`.
            dev_dropped += 1
            continue
        out.append(ln)
        continue
    if section is not None and is_dev_deps(section):
        # Skip the dev-dependency body lines (up to the next table header).
        continue
    out.append(ln)

open(p, "w", encoding="utf-8", newline="\n").write("\n".join(out) + "\n")
print(f"  {p}: dropped {dev_dropped} [dev-dependencies] table(s)")
PY
    done
else
    echo "nirs4allformats configure: ERROR — python3 required to trim the dev-dependencies" >&2
    exit 1
fi

# 2. The copied crate Cargo.tomls use `.workspace = true` for version/edition/
#    license/authors/repository AND for several dependencies (serde, serde_json,
#    sha2, thiserror, nirs4all-formats-core). Those inherit from the MONOREPO
#    [workspace], which is NOT in the tarball. So we make src/rust/ a self-
#    contained workspace ROOT that re-declares [workspace.package] and
#    [workspace.dependencies] with the same values, plus the two vendored crates
#    as members. The copied crate manifests then resolve unchanged.
#
#    This same manifest is also the extendr staticlib [package]; it points at
#    the vendored core crates through the local [workspace.dependencies].
cat > "$RUST/Cargo.toml" <<'TOML'
# GENERATED by ./configure (N4FMT_R_VENDOR=1) — self-contained vendored workspace.
#
# This manifest is BOTH the workspace root AND the extendr staticlib package.
# The two core crates under vendored/ are workspace members; they inherit
# version/deps from [workspace.package] / [workspace.dependencies] below, which
# mirror the monorepo root Cargo.toml (the source tarball has no monorepo).
[workspace]
resolver = "2"
members = [
    "vendored/nirs4all-formats-core",
    "vendored/nirs4all-formats",
]

[workspace.package]
version = "0.1.0-alpha.1"
edition = "2021"
license = "MIT"
authors = ["G. Beurier <beurier@cirad.fr>"]
repository = "https://github.com/GBeurier/nirs4all-formats"
homepage = "https://github.com/GBeurier/nirs4all-formats"
readme = "README.md"

[workspace.dependencies]
nirs4all-formats-core = { path = "vendored/nirs4all-formats-core" }
nirs4all-formats = { path = "vendored/nirs4all-formats" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.10"
thiserror = "2.0"

[package]
name = "nirs4allformats-r"
version = "0.1.0-alpha.1"
edition = "2021"
publish = false

[lib]
crate-type = ["staticlib"]
name = "nirs4allformats_r"

[dependencies]
extendr-api = { version = "0.7", default-features = false }
# COMPLETE build: default features ON — the facade's `formats-all` keeps every
# reader (HDF5/netCDF, Parquet/Arrow, MATLAB). This is the canonical package
# `nirs4allformats`. The smaller sibling `nirs4allformats.lite` sets
# `default-features = false, features = ["fmt-hdf5", "fmt-matlab"]` here, which
# drops ONLY the Parquet/Arrow reader.
nirs4all-formats = { path = "vendored/nirs4all-formats" }
nirs4all-formats-core = { path = "vendored/nirs4all-formats-core" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

[profile.release]
opt-level = 2
lto = "thin"
TOML

# 3. cargo vendor every crates.io transitive dep, then compress it. The
#    crates.io source replacement (`[source.crates-io] replace-with =
#    "vendored-sources"`, `[source.vendored-sources] directory = "vendor"`) is
#    NOT written to a config file — src/Makevars passes it INLINE via
#    `cargo build --config source.crates-io.replace-with=...
#    --config source.vendored-sources.directory="vendor"`. Inline --config
#    KEY=VALUE resolves the relative `vendor` directory against the cargo CWD
#    (src/rust/), unlike a `--config <file>` whose relative paths resolve against
#    the file's own dir; and crucially the package then ships NO hidden
#    `.cargo/` directory (which would trip R CMD check's "hidden files" NOTE).
echo "nirs4allformats configure: cargo vendor (crates.io transitive deps)"
( cd "$RUST" && cargo vendor --versioned-dirs vendor ) >/dev/null

# 3a. Strip CRAN-tripping stray files from the vendored crates — two classes:
#
#       * stray CITATION.cff / CITATION (R CMD check --as-cran NOTEs any CITATION
#         outside inst/: "CITATION file in a non-standard place"; chrono ships a
#         top-level CITATION.cff);
#       * GNU-extension Makefiles bundled inside C-library crates that cargo
#         compiles via their own build.rs and NEVER invokes
#         (lzma-sys' xz-5.2/dos/Makefile, xz-5.2/po/Makevars, the autotools
#         Makefile.am/.inc inputs; r-efi's maintenance Makefile). R CMD check's
#         "GNU make extensions" WARNING scans every Makefile/Makevars/GNUmakefile
#         in the unpacked+installed tree, including the extracted vendor/, so they
#         must go. Verified: lzma-sys' build.rs compiles the C sources directly
#         with `cc` (no Makefile reference) and r-efi's Makefile is CI-only — both
#         build fine offline after removal.
#
#     Removing a file alone would break cargo's OFFLINE checksum verification, so
#     we also drop its entry from the crate's `.cargo-checksum.json` (cargo only
#     verifies the files it lists). Walk recursively: the offending Makefiles are
#     nested several levels deep inside the C-source subtrees. python3 is the
#     vendoring host's JSON editor; it is only needed when vendoring (CRAN's
#     install never reaches this branch — it unpacks the already-stripped tree).
if command -v python3 >/dev/null 2>&1; then
    echo "nirs4allformats configure: stripping stray CITATION + GNU-make Makefiles from vendored crates"
    python3 - "$RUST/vendor" <<'PY'
import json, os, re, sys

root = sys.argv[1]

# A vendored file is dropped if its BASENAME is a stray CITATION or any
# Make-family file: Makefile / GNUmakefile / Makevars, the autotools
# Makefile.am / Makefile.in / Makefile.inc inputs, and the cargo-make
# Makefile.toml task config (half-2.7.1). None are used by the R build (every
# C-library crate compiles via its own build.rs/`cc`); they only exist to trip
# R CMD check's "GNU make extensions" scan of the unpacked+installed tree.
# Matching the basename covers the deep-nested copies
# (e.g. xz-5.2/src/liblzma/lzma/Makefile.inc) because the .cargo-checksum.json
# keys them by crate-relative path. NB: a real R-package Makefile.win is NOT in
# the vendor tree, so it is never affected.
CITATION = {"CITATION.cff", "CITATION"}
MAKE_RE = re.compile(r"^(GNU)?[Mm]ake(file|vars)(\.(am|in|inc|toml))?$")


def is_stray(basename):
    return basename in CITATION or bool(MAKE_RE.match(basename))


cit_removed = mk_removed = 0
for name in sorted(os.listdir(root)):
    d = os.path.join(root, name)
    cj = os.path.join(d, ".cargo-checksum.json")
    if not os.path.isdir(d) or not os.path.exists(cj):
        continue
    with open(cj, encoding="utf-8") as fh:
        meta = json.load(fh)
    files = meta.get("files", {})
    changed = False
    for fname in list(files):
        base = os.path.basename(fname)
        if not is_stray(base):
            continue
        fp = os.path.join(d, fname)
        if os.path.exists(fp):
            os.remove(fp)
        del files[fname]
        changed = True
        if base in CITATION:
            cit_removed += 1
        else:
            mk_removed += 1
    if changed:
        with open(cj, "w", encoding="utf-8", newline="\n") as fh:
            json.dump(meta, fh)
print(f"  stripped {cit_removed} CITATION + {mk_removed} GNU-make file(s) from the vendored tree")
PY
else
    echo "nirs4allformats configure: WARNING python3 not found — leaving stray CITATION/Makefiles in the vendored tree (R CMD check will emit NOTEs/WARNINGs)" >&2
fi

echo "nirs4allformats configure: compressing vendor/ -> vendor.tar.xz (avoids R's tarball dotfile stripping)"
( cd "$RUST" && tar cJf vendor.tar.xz vendor && rm -rf vendor )

echo "nirs4allformats configure: self-contained Rust tree ready"
echo "  vendored crates : $(ls "$VENDORED" | tr '\n' ' ')"
echo "  vendor archive  : $VENDOR_ARCHIVE ($(du -h "$VENDOR_ARCHIVE" | cut -f1))"
echo "  source replace  : passed INLINE to cargo by src/Makevars (--config), no .cargo/ dir"
