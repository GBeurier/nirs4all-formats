# Windows (Rtools / UCRT) extendr staticlib build for the COMPLETE
# nirs4allformats package. Same CRAN-compliant shape as src/Makevars: build-local
# CARGO_HOME + CARGO_TARGET_DIR (never ~/.cargo), version echoed to the log before
# compiling, post-link rust_clean wipes all Rust scratch from the package source.
#
# WINDOWS MAX_PATH (260). R CMD check installs into
# <pkg>.Rcheck/00_pkg_src/<pkg>/src, an already ~200-char path. Cargo then writes
# the heavy C-library crates' object files at target/<triple>/release/build/
# lzma-sys-<hash>/out/<hash>-lzma_encoder_optimum_fast.o, which pushes the full
# path past 260 and makes the cc-rs `ar` step fail ("No such file or directory").
# So on Windows the cargo target dir (and the build-local CARGO_HOME) are RELOCATED
# to a short directory under the session temp instead of $(CURDIR)/rust/target.
# TMPDIR is exported by R during install; fall back to TEMP/TMP, then /tmp.
TARGET ?= $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu
# Short build root under the session temp (R exports TMPDIR; fall back TEMP/TMP,
# then /tmp). Backslashes are normalised to forward slashes so the path is safe
# for both the Rtools shell (mkdir/rm) and the native cargo.exe.
WIN_TMP_RAW = $(if $(TMPDIR),$(TMPDIR),$(if $(TEMP),$(TEMP),$(if $(TMP),$(TMP),/tmp)))
WIN_TMP = $(subst \,/,$(WIN_TMP_RAW))
TARGET_DIR = $(WIN_TMP)/n4ffull
CARGOTMP = $(WIN_TMP)/n4ffull-ch
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libnirs4allformats_r.a
PKG_LIBS = -L$(LIBDIR) -lnirs4allformats_r -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll
PKG_CFLAGS = -I$(CURDIR)/rust/src

all: $(SHLIB) rust_clean

.PHONY: all rust_clean clean C_clean $(STATLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	@if ! command -v cargo >/dev/null; then \
		echo "Cargo is required to build nirs4allformats. Install Rust from https://rustup.rs."; \
		exit 1; \
	fi
	# `rustc` links the x86_64-pc-windows-gnu target against `-lgcc_eh`, but
	# Rtools' GCC ships no `libgcc_eh.a`, so the final link fails ("Installation
	# failed") without this shim: an empty libgcc_eh.a on LIBRARY_PATH satisfies
	# the linker. This is the canonical extendr Windows workaround. See
	# https://github.com/r-windows/rtools-packages/blob/2407b23f1e0925bbb20a4162c963600105236318/mingw-w64-gcc/PKGBUILD#L313-L316
	mkdir -p $(TARGET_DIR)/libgcc_mock
	touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a
	# Report the toolchain version to the install log (stderr) BEFORE compiling, so
	# the R CMD check --as-cran "Rust compilation" check finds a `rustc <ver>` line
	# (otherwise it WARNs "No rustc version reported prior to compilation").
	@rustc --version >&2 || true
	@cargo --version >&2 || true
	# Self-contained vendored build: extract the cargo-vendored crates.io deps
	# (shipped compressed), then build OFFLINE with the crates.io source
	# replacement passed INLINE via --config (no hidden .cargo/ dir). Rtools
	# provides tar/xz; the dev fallback (no vendor.tar.xz) builds online.
	# CARGO_HOME=$(CARGOTMP) keeps cargo off %USERPROFILE%\.cargo (CRAN Policy) and,
	# like CARGO_TARGET_DIR, lives under the short session temp to dodge MAX_PATH.
	# CARGO_LINKER (Rtools mingw linker) comes from Makevars.ucrt on R >= 4.2;
	# CARGO_TARGET_..._LINKER + LIBRARY_PATH wire in the linker and the gcc_eh shim.
	# `-j 2` bounds Cargo's parallelism as required by CRAN's "Using Rust" policy.
	export CARGO_HOME="$(CARGOTMP)" && \
	export CARGO_TARGET_DIR="$(TARGET_DIR)" && \
	export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$(CARGO_LINKER)" && \
	export LIBRARY_PATH="$${LIBRARY_PATH};$(TARGET_DIR)/libgcc_mock" && \
	if [ -f rust/vendor.tar.xz ]; then \
		[ -d rust/vendor ] || ( echo "extracting rust/vendor.tar.xz"; cd rust && tar xJf vendor.tar.xz ); \
		cd rust && cargo build --release -j 2 --target $(TARGET) --offline \
			--config 'source.crates-io.replace-with="vendored-sources"' \
			--config 'source.vendored-sources.directory="vendor"'; \
	else \
		cd rust && cargo build --release -j 2 --target $(TARGET); \
	fi

# Post-link cleanup — see src/Makevars. Runs after $(SHLIB) links $(STATLIB),
# wiping the relocated target/ + CARGO_HOME (both under the session temp) and the
# extracted vendor/ so R CMD check does not scan third-party build artefacts.
# Skipped when NOT_CRAN=true.
rust_clean: $(SHLIB)
	@if [ "$(NOT_CRAN)" != "true" ]; then \
		rm -Rf "$(TARGET_DIR)" "$(CARGOTMP)" "$(CURDIR)/rust/vendor"; \
	fi

C_clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) $(TARGET_DIR) $(CARGOTMP) $(CURDIR)/rust/vendor

clean: C_clean
