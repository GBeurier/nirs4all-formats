.DS_Store
asd_reader_*.log
# wasm-pack build output (regenerated by `wasm-pack build`).
/bindings/wasm/pkg/
/bindings/wasm/pkg-node/
# R native build artifacts produced by `R CMD INSTALL`.
/bindings/r/nirs4allformats/src/rust/target/
/bindings/r/nirs4allformats/src/*.o
# Cargo.lock for the bindings crates is generated on first build.
/bindings/python/Cargo.lock
/bindings/wasm/Cargo.lock
# uv writes this when resolving the Python binding's dev env.
/bindings/python/uv.lock

# agent session scratch
.claude/
.codegraph/

